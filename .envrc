# Loads devShells.default from flake.nix (typst, poppler, ghostscript,
# Python + deps, and the `noteworthy` launcher).
#
# Requires `direnv allow` once. nix-direnv is recommended for caching:
#   https://github.com/nix-community/nix-direnv
#
# To work in the uv-based shell instead, put `use flake .#uv` in .envrc.local.
use flake

# Plain direnv re-evaluates only when these change; nix-direnv tracks them itself.
watch_file flake.nix
watch_file flake.lock

# Personal, gitignored overrides (e.g. NOTEWORTHY_* vars, a different shell).
dotenv_if_exists .env
source_env_if_exists .envrc.local
